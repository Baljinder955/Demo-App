default_platform(:ios)

  platform :ios do
  desc "🚀 CI build (unsigned)"
  lane :build_ci do
    gym(
      project: "SpeechToText.xcodeproj",
      scheme: "SpeechToText",
      configuration: "Debug",
      export_method: "development",
      team_id: "R6Q7H67G9C",               # ← USE YOUR TEAM ID
      codesigning_identity: "Apple Development",
      skip_codesigning: false
    )
  end

  desc "🔐 Signed IPA (Development)"
  lane :ci_signed do
    gym(
      project: "SpeechToText.xcodeproj",
      scheme: "SpeechToText",               # ⚠️ UPDATE IF DIFFERENT
      configuration: "Release",
      clean: true,
      export_method: "development"
    )
  end

end
