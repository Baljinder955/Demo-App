# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do

  desc "🚀 CI build (unsigned, no IPA export)"
  lane :build_ci do
    project_path = File.expand_path("../SpeechToText.xcodeproj", __dir__)
    sh("xcodebuild -scheme SpeechToText \
      -project #{project_path} \
      -configuration Debug \
      -sdk iphonesimulator \
      build")
    UI.success("🎉 Build completed successfully! (No signing, no IPA)")
  end

  # ------------------------------------------
  # 📌 NEW LANE: Create IPA (unsigned)
  # ------------------------------------------
  desc "📦 Build unsigned IPA (local)"
  lane :ipa_local_unsigned do
    gym(
      project: "SpeechToText.xcodeproj",
      scheme: "SpeechToText",
      configuration: "Release",
      skip_codesigning: true,
      export_method: "development",
      output_directory: "./build",
      output_name: "SpeechToText-unsigned"
    )
    UI.success("🎉 Unsigned IPA Created at ./build/SpeechToText-unsigned.ipa")
  end

  # ------------------------------------------
  # 📌 NEW LANE: Create Signed IPA (needs team id)
  # ------------------------------------------
  desc "🔐 Build Signed IPA for devices"
  lane :ipa_local_signed do
    gym(
      project: "SpeechToText.xcodeproj",
      scheme: "SpeechToText",
      configuration: "Release",
      export_method: "development",
      export_xcargs: "DEVELOPMENT_TEAM=YOUR_TEAM_ID",
      output_directory: "./ipa_signed",
      output_name: "SpeechToText-signed"
    )
    UI.success("🎉 Signed IPA Created at ./ipa_signed/SpeechToText-signed.ipa")
  end


end
